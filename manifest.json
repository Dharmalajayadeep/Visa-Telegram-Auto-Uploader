{
  "manifest_version": 3,
  "name": "Visa Telegram Extension",
  "description": "Automatically capture appointment screenshots and upload them to Telegram.",
  "version": "0.1",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Visa Telegram Extension"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
